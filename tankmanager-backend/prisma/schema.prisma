generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id            String       @id @default(uuid())
  name          String       @unique
  domain        String?      @unique
  email         String?
  phone         String?
  address       String?
  active        Boolean      @default(true)
  licenseExpiry DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  categories    Category[]
  invitations   Invitation[]
  machines      Machine[]
  owners        Owner[]
  users         User[]

  @@index([name])
  @@index([active])
}

model User {
  id              String               @id @default(uuid())
  companyId       String
  email           String               @unique
  passwordHash    String
  firstName       String
  lastName        String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastLoginAt     DateTime?
  createdMachines Machine[]            @relation("MachineCreator")
  passwordResets  PasswordReset[]
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles           UserRoleAssignment[]

  @@index([companyId])
  @@index([email])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  role       UserRole
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model Invitation {
  id        String    @id @default(uuid())
  companyId String
  email     String
  firstName String?
  lastName  String?
  token     String    @unique @default(uuid())
  roles     String
  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  invitedBy String
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([token])
  @@index([email])
  @@index([used])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @default(uuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([used])
}

model Owner {
  id        String    @id @default(uuid())
  name      String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companyId String
  machines  Machine[]
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id                  String          @id @default(uuid())
  name                String
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  hasEngine           Boolean         @default(true)
  inventoryMiddleHint String?
  inventoryPrefix     String?
  companyId           String?
  company             Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields              CategoryField[]
  machines            Machine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
}

model CategoryField {
  id            String              @id @default(uuid())
  categoryId    String
  key           String
  label         String
  type          CategoryFieldType
  required      Boolean             @default(false)
  optionsJson   String?
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  machineValues MachineFieldValue[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model Machine {
  id                String              @id @default(uuid())
  inventoryNo       String
  counterType       CounterType
  counterStartValue Decimal             @db.Decimal(12, 2)
  status            MachineStatus       @default(ACTIVE)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  buildYear         Int?
  categoryId        String
  counterCurrent    Decimal?            @db.Decimal(12, 2)
  designation       String
  manufacturer      String?
  modelType         String?
  ownerId           String
  primaryFuelType   FuelType?
  adBlueRequired    Boolean             @default(false)
  inventoryMiddle   String?
  serialNumber      String?
  createdBy         String?
  licensePlate      String?
  stvzoApproved     Boolean             @default(false)
  companyId         String
  files             File[]
  fuelEntries       FuelEntry[]
  category          Category            @relation(fields: [categoryId], references: [id])
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator           User?               @relation("MachineCreator", fields: [createdBy], references: [id])
  owner             Owner               @relation(fields: [ownerId], references: [id])
  dynamicValues     MachineFieldValue[]
  maintenancePlans  MaintenancePlan[]

  @@unique([companyId, inventoryNo])
  @@index([companyId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([inventoryNo])
}

model MachineFieldValue {
  id        String        @id @default(uuid())
  machineId String
  fieldId   String
  value     String?
  updatedAt DateTime      @updatedAt
  field     CategoryField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  machine   Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, fieldId])
  @@index([machineId])
  @@index([fieldId])
}

model File {
  id         String     @id @default(uuid())
  machineId  String
  module     FileModule @default(MACHINE)
  title      String?
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  storageKey String
  uploadedBy String?
  uploadedAt DateTime   @default(now())
  machine    Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, module])
}

model MaintenancePlan {
  id            String       @id @default(uuid())
  machineId     String
  title         String
  intervalType  IntervalType
  intervalValue Int
  preAlertValue Int?
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  machine       Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
}

model FuelEntry {
  id           String   @id @default(uuid())
  machineId    String
  dateTime     DateTime
  userName     String
  fuelType     FuelType
  liters       Decimal  @db.Decimal(12, 2)
  counterValue Decimal? @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())
  machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, dateTime])
  @@index([fuelType])
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  LOANED
}

enum CounterType {
  HOURS
  KM
  NONE
}

enum FuelType {
  DIESEL
  GASOLINE
  ELECTRIC
}

enum CategoryFieldType {
  TEXT
  NUMBER
  DATE
  BOOL
  SELECT
}

enum IntervalType {
  HOURS
  KM
  DAYS
}

enum FileModule {
  MACHINE
  MAINTENANCE
  UVV
}

enum UserRole {
  ADMIN
  DRIVER
  MECHANIC
  MANAGEMENT
  VIEWER
}
