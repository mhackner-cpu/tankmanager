# Production Environment Variables für Railway

# Node Environment
NODE_ENV=production

# Database (automatisch von Railway gesetzt)
DATABASE_URL=${Postgres.DATABASE_URL}

# JWT Secret (Generieren Sie einen langen, zufälligen String)
JWT_SECRET=super-secret-jwt-key-change-me-in-production-min-32-characters

# Frontend URL (Ihre Vercel URL)
FRONTEND_URL=https://ihre-domain.vercel.app

# File Storage - Option 1: Local (Standard)
STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads

# File Storage - Option 2: Cloudflare R2 (Empfohlen für Production)
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=ihr-cloudflare-account-id
# R2_ACCESS_KEY_ID=ihr-r2-access-key-id
# R2_SECRET_ACCESS_KEY=ihr-r2-secret-access-key
# R2_BUCKET_NAME=tankmanager-files
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Port (automatisch von Railway gesetzt via $PORT)
# PORT=3005
